#include <stdio.h>

int main() {
    int n, i, time = 0, completed = 0;
    int at[20], bt[20], rt[20], pr[20];
    int wt[20], tat[20], ct[20];
    int min, index;
    float avg_wt = 0, avg_tat = 0;

    printf("Enter number of processes: ");
    scanf("%d", &n);

    printf("\nEnter Arrival Time, Burst Time and Priority:\n");
    for(i = 0; i < n; i++) {
        printf("P%d\n", i + 1);

        printf("Arrival Time: ");
        scanf("%d", &at[i]);

        printf("Burst Time: ");
        scanf("%d", &bt[i]);

        printf("Priority: ");
        scanf("%d", &pr[i]);

        rt[i] = bt[i];     // Remaining Time
    }

    while(completed != n) {
        min = 9999;
        index = -1;

        // Select highest priority process among arrived processes
        for(i = 0; i < n; i++) {
            if(at[i] <= time && rt[i] > 0) {
                if(pr[i] < min) {
                    min = pr[i];
                    index = i;
                }
            }
        }

        if(index == -1) {
            time++;
            continue;
        }

        // Execute process for one unit
        rt[index]--;
        time++;

        if(rt[index] == 0) {
            completed++;
            ct[index] = time;
            tat[index] = ct[index] - at[index];
            wt[index] = tat[index] - bt[index];

            avg_wt += wt[index];
            avg_tat += tat[index];
        }
    }

    printf("\n---------------------------------------------------------------\n");
    printf("Process\tAT\tBT\tPR\tCT\tWT\tTAT\n");
    printf("---------------------------------------------------------------\n");

    for(i = 0; i < n; i++) {
        printf("P%d\t%d\t%d\t%d\t%d\t%d\t%d\n",
               i + 1, at[i], bt[i], pr[i],
               ct[i], wt[i], tat[i]);
    }

    printf("---------------------------------------------------------------\n");
    printf("Average Waiting Time = %.2f\n", avg_wt / n);
    printf("Average Turnaround Time = %.2f\n", avg_tat / n);

    return 0;
}


